# ==========================================
# AutoScan Pro — GitHub GitIgnore Configuration
# ==========================================

# ── 1. Virtual Environments & Secrets ──
.venv/
env/
venv/
ENV/
.env

# ── 2. Build & Packaging Artifacts (PyInstaller) ──
build/
dist/
*.spec
*.manifest

# ── 3. Heavy AI Model Weights (YOLO) ──
*.pt
best.pt
yolov8n.pt

# ── 4. Runtime Databases & Media Uploads ──
data/
uploads/
reports/
*.sqlite3
*.db
db.sqlite3-journal

# ── 5. Temporary & Test Output Files ──
*.pdf
test_*.html
path/
test-results/
playwright-report/
blob-report/
/playwright/.cache/
/playwright/.auth/

# ── 6. Node.js & Dependencies ──
node_modules/
frontend/node_modules/
package-lock.json

# ── 7. Python Bytecode & Cache ──
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── 8. IDE & Local Workspace Configs ──
.obsidian/
.continue/
.idea/
.vscode/
.DS_Store
Thumbs.db
